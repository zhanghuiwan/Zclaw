# ============================================
# Zclaw 配置文件 (.env)
# ============================================
# 复制此文件为 .env 并填入你的配置:
#   cp .env.example .env
#
# 然后运行: python main.py
# ============================================

# --- LLM 提供者选择 ---
# 可选值: bailian (阿里百炼), ollama (本地模型), 或自定义名称
ZCLAW_PROVIDER=bailian

# --- 模型名称 ---
# 百炼示例: qwen-plus, qwen-max, qwen-turbo
# Ollama 示例: qwen2.5:latest, llama3.1:latest, deepseek-r1:latest
ZCLAW_MODEL=qwen-plus

# --- API Key ---
# 百炼: 在 https://dashscope.console.aliyun.com/ 获取
# Ollama: 留空即可
ZCLAW_API_KEY=your_api_key_here

# --- API 基础 URL ---
# 百炼 (默认): https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama (默认): http://localhost:11434/v1
ZCLAW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 高级配置 (可选) ---

# 最大上下文 token 数
# ZCLAW_MAX_CONTEXT_TOKENS=131072

# 温度参数 (0.0 - 1.0, 越低越精确)
# ZCLAW_TEMPERATURE=0.3

# 最大生成 token 数
# ZCLAW_MAX_TOKENS=8192

# Agent 最大循环轮数
# ZCLAW_MAX_LOOP_ROUNDS=50


# ============================================
# 快速配置模板
# ============================================

# --- 使用阿里百炼 ---
# ZCLAW_PROVIDER=bailian
# ZCLAW_MODEL=qwen-plus
# ZCLAW_API_KEY=sk-xxxxxxxxxxxxxxxx
# ZCLAW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 使用本地 Ollama ---
# ZCLAW_PROVIDER=ollama
# ZCLAW_MODEL=qwen2.5:latest
# ZCLAW_API_KEY=ollama
# ZCLAW_BASE_URL=http://localhost:11434/v1

# --- 使用 OpenAI ---
# ZCLAW_PROVIDER=openai
# ZCLAW_MODEL=gpt-4o
# ZCLAW_API_KEY=sk-xxxxxxxxxxxxxxxx
# ZCLAW_BASE_URL=https://api.openai.com/v1

# --- 使用 DeepSeek ---
# ZCLAW_PROVIDER=deepseek
# ZCLAW_MODEL=deepseek-chat
# ZCLAW_API_KEY=sk-xxxxxxxxxxxxxxxx
# ZCLAW_BASE_URL=https://api.deepseek.com/v1
