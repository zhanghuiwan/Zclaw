FROM python:3.11-slim

LABEL maintainer="Zclaw"
LABEL description="Zclaw Gateway - 24/7 Autonomous Agent"

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 安装 Playwright 浏览器
RUN playwright install --with-deps chromium

# 复制应用代码
COPY . .

# 创建非 root 用户
RUN useradd -m -s /bin/bash zclaw && \
    mkdir -p /home/zclaw/.Zclaw && \
    chown -R zclaw:zclaw /app

USER zclaw

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# 暴露端口
EXPOSE 8080

# 启动命令
CMD ["python", "-m", "src.web.gateway_server"]
